# Copy to .env (gitignored; Bun loads it automatically). Never commit real credentials.

# OpenF1 sponsor account (https://openf1.org, EUR 9.90/month): needed for live timing (`bun run live`).
# Also lifts `bun run ingest` to the faster sponsor rate limits. Leave empty for the free tier.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Port of the live relay (Vite proxies /relay to it). Default 8787.
# LIVE_PORT=8787

# Simulated live session from a cached race instead of OpenF1 (see README, Live mode).
# LIVE_SIMULATE=11377
# LIVE_SIMULATE_SPEED=1
# LIVE_SIMULATE_START=-60

# Credential vault (vault/, see vault/README.md). Where the app finds it (default http://localhost:5174; "off" disables it),
# and which app origins the vault lets embed it (baked into its build; default the local app).
# VITE_VAULT_ORIGIN=http://localhost:5174
# VAULT_APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
