# F1 data (F1 timing data is © Formula One World Championship Limited; not redistributable).
# Never commit or bundle it: the app downloads races from OpenF1 into each user's own browser, and the
# optional CLI (`bun run ingest`) keeps its copy here: raw OpenF1 responses in data/raw/, processed
# sessions in data/sessions/.
/data/

# Circuit history (scripts/circuit-history.ts): built from F1DB before every deploy, not committed.
/public/history/

# CodeGraph index (local code navigation)
.codegraph/

# Wrangler (Cloudflare deploy) local state
.wrangler/

# Impeccable design tooling: only the design spec and live-mode wiring are tracked
.impeccable/*
!.impeccable/design.json
!.impeccable/live/
.impeccable/live/*
!.impeccable/live/config.json
