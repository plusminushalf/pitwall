// Cloudflare Workers, static assets only: dist/ served at pitwall.plusminushalf.com, with index.html for the app's own
// paths (/session/11377, /live: src/url.ts) and predictions/index.html for /predictions.
// `bun run deploy` builds and uploads; the custom domain's DNS record and certificate are created on first deploy.
//
// For one deploy: Called It had a Worker and a Durable Object (PredictionStore). Cloudflare only deletes a Durable
// Object class through a migration, and a migration needs a script, so worker/retire.ts is here (no path runs it)
// until this deploy has deleted the class; the next one drops it and goes back to assets only.
{
  "name": "pitwall",
  "main": "worker/retire.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PredictionStore"] },
    { "tag": "v2", "deleted_classes": ["PredictionStore"] },
  ],
  "routes": [{ "pattern": "pitwall.plusminushalf.com", "custom_domain": true }],
}
