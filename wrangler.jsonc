// Cloudflare Workers: dist/ served at pitwall.plusminushalf.com, with index.html for the app's own paths
// (/session/11377, /live: src/url.ts). Static files never touch the Worker; only Called It's paths run it first
// (worker/index.ts): its API and its page. Calls live in the PredictionStore Durable Object's SQLite database.
// `bun run deploy` builds and uploads; the custom domain's DNS record and certificate are created on first deploy.
{
  "name": "pitwall",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/predictions", "/predictions/*"],
  },
  "durable_objects": { "bindings": [{ "name": "PREDICTIONS", "class_name": "PredictionStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PredictionStore"] }],
  "routes": [{ "pattern": "pitwall.plusminushalf.com", "custom_domain": true }],
}
