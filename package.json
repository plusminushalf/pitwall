  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "VITE_VAULT_ORIGIN=https://pitwall-auth.garvit.in VITE_CF_BEACON_TOKEN=6bdce605bfa94f82b30ab2cec4d08fa5 vite build && bunx wrangler@4 deploy",
    "test": "bun test",
    "races": "bun scripts/list-races.ts",
    "ingest": "bun scripts/ingest.ts",
    "ingest:season": "bun scripts/ingest-season.ts",
    "check:quali": "bun scripts/check-quali.ts",
    "live": "bun server/live.ts",
    "live:sim": "LIVE_SIMULATE=11377 bun server/live.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p vault/tsconfig.json && tsc --noEmit -p vault/tsconfig.node.json",
    "lint": "bun scripts/lint-widgets.ts src/widgets",
    "vault": "vite --config vault/vite.config.ts",
    "vault:build": "vite build --config vault/vite.config.ts",
    "vault:deploy": "VAULT_APP_ORIGINS=https://pitwall.plusminushalf.com vite build --config vault/vite.config.ts && bunx wrangler@4 deploy --config vault/wrangler.jsonc",
    "vault:serve": "bun vault/serve.ts",
    "vault:e2e": "bun vault/e2e.ts",
    "live:check": "bun vault/livecheck.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "modern-screenshot": "^4.7.0",
    "mqtt": "^5.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
